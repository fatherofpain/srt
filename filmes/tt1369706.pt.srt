# Corra, benzinho corra #

135
00:23:48,031 --> 00:23:52,481
# Corra, benzinho corra #
# Já estou chegando #

136
00:23:52,640 --> 00:23:56,636
# Corra, benzinho corra #
# Traga seus beijos para mim #

137
00:23:56,731 --> 00:23:58,481
# Corra, benzinho corra #

138
